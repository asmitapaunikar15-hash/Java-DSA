class Solution {
    public int[] frequencySort(int[] nums) {
        int n=nums.length;
        int temp;
        for(int i=0;i<n-1;i++){
            for(int j=i+1;j<n;j++){
                int freq1=0;
                int freq2=0;

                for(int c=0;c<n;c++){
                    if(nums[c]==nums[i]){
                        freq1++;
                    }
                }
                for(int c=0;c<n;c++){
                    if(nums[c]==nums[j]){
                        freq2++;
                    }
                }
                if(freq1>freq2){
                    temp=nums[i];
                    nums[i]=nums[j];
                    nums[j]=temp;
                }
                else if(freq1==freq2 && nums[i]<nums[j]){
                    temp=nums[i];
                    nums[i]=nums[j];
                    nums[j]=temp;
                }

            }//for loop of j
        }//for loop of i
        return nums;
    }
}
